                                      ]
                                    },
                                    "hash": {
                                      "type": "string",
                                      "enum": [
                                        "SHA-256"
                                      ]
                                    },
                                    "iterations": {
                                      "type": "number"
                                    },
                                    "salt": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "algorithm",
                                    "hash",
                                    "iterations",
                                    "salt"
                                  ]
                                }
                              },
                              "required": [
                                "ciphertext",
                                "iv",
                                "kdf"
                              ]
                            }
                          },
                          "required": [
                            "title",
                            "body"
                          ]
                        }
                      },
                      "required": [
                        "taskId",
                        "clock",
                        "status",
                        "encrypted"
                      ]
                    }
                  }
                },
                "required": [
                  "packets"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "in": "header",
            "name": "authorization",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "written": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "written"
                      ],
                      "additionalProperties": false
                    },
                    "reqId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "reqId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
