                        "taskId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "clock": {
                          "type": "object",
                          "properties": {
                            "physical": {
                              "type": "number"
                            },
                            "counter": {
                              "type": "number"
                            },
                            "nodeId": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "physical",
                            "counter",
                            "nodeId"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "inbox",
                            "active",
                            "exported",
                            "archived"
                          ]
                        },
                        "encrypted": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "object",
                              "properties": {
                                "ciphertext": {
                                  "type": "string"
                                },
                                "iv": {
                                  "type": "string"
                                },
                                "kdf": {
                                  "type": "object",
                                  "properties": {
                                    "algorithm": {
                                      "type": "string",
                                      "enum": [
                                        "PBKDF2"
                                      ]
                                    },
                                    "hash": {
                                      "type": "string",
                                      "enum": [
                                        "SHA-256"
                                      ]
                                    },
                                    "iterations": {
                                      "type": "number"
                                    },
                                    "salt": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "algorithm",
                                    "hash",
                                    "iterations",
                                    "salt"
                                  ]
                                }
                              },
                              "required": [
                                "ciphertext",
                                "iv",
                                "kdf"
                              ]
                            },
                            "body": {
                              "type": "object",
                              "properties": {
                                "ciphertext": {
                                  "type": "string"
                                },
                                "iv": {
                                  "type": "string"
                                },
                                "kdf": {
