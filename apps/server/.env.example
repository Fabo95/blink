# Blink sync server (apps/server) environment.
# Copy to apps/server/.env and fill in the values — src/env.ts has no defaults, so
# every var here is required.

# HTTP port the server listens on.
PORT=8787

# development | test | production | staging
ENVIRONMENT=development

# Postgres. The server connects as the least-privilege `blink_api` role (created by
# migration 0001); the owner `blink` is used only for migrations/DDL. Under docker the
# compose file overrides the host to `postgres`.
DATABASE_URL=postgres://blink_api:blink_api_dev_password@localhost:5432/blink

# Better Auth signing secret (>=32 chars). Generate a real one: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-32ch

# The server's own public base URL (Better Auth is mounted at /v1/auth).
BETTER_AUTH_URL=http://localhost:8787

# CORS: comma-separated origins (supports `regex:` prefixes). The desktop dev origin.
CORS_ORIGINS=http://localhost:1420

# Resend API key for outbound email (verification codes). REQUIRED — get one at
# https://resend.com. The inlined From (onboarding@resend.dev) only delivers to your
# own Resend account address until you verify a domain in Resend.
RESEND_API_KEY=re_your_key_here
