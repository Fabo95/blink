{
  "name": "@blink/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "description": "Blink self-hosted sync API — the thin tier between clients and Cloud-Postgres.",
  "scripts": {
    "dev": "pnpm --filter @blink/contract --filter @blink/db build && ENVIRONMENT=development tsx watch src/index.ts",
    "build": "rm -rf ./dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blink/contract": "workspace:*",
    "@blink/db": "workspace:*",
    "@fastify/awilix": "^8.2.0",
    "@fastify/cors": "^11.3.0",
    "awilix": "^13.0.5",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
