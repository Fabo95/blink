{
  "name": "@blink/sync-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "description": "Blink self-hosted sync API — the thin tier between clients and Cloud-Postgres.",
  "scripts": {
    "dev": "pnpm --filter @blink/db build && ENVIRONMENT=development tsx watch src/index.ts",
    "build": "rm -rf ./dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blink/db": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.8.1",
    "fastify-type-provider-zod": "^4.0.2",
    "pino": "^10.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  }
}
