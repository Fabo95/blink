# Desktop app environment — copy to `.env` (gitignored) in this folder.
# Loaded at startup by the Rust core (dotenvy). Real exported env vars still win.

# The Blink sync server base URL (defaults to http://localhost:8787 when unset).
BLINK_SERVER_URL=

# The OpenAI API key is NOT an env var — it's the user's own, entered in the app's
# AI settings after a connection test and stored in the OS keychain.
