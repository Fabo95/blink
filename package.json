{
  "name": "blink",
  "version": "0.1.0",
  "private": true,
  "description": "Blink — Enterprise-Ready Local-First Task Ingestion System",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "desktop": "pnpm --filter @blink/desktop dev",
    "tauri": "pnpm --filter @blink/desktop tauri"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
