# Blink environment — copy to .env and fill in per environment.
# Phase 1 (local-first MVP) needs none of these; they gate later phases.

# --- Phase 2: Cloud Sync (Supabase / Cloud-Postgres) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Phase 1/2: AI title generation (cloud proxy over Enterprise VPN) ---
# Leave empty to use the on-device / heuristic engine.
BLINK_AI_PROXY_URL=

# --- Phase 1: Linear export (direct OAuth in client) ---
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
