# Blink environment — copy to .env and fill in per environment.
# Phase 1 (local-first MVP) needs none of these; they gate later phases.

# --- Phase 2 / VPC: Self-hosted Cloud Sync ---
# The sync API (apps/server) connects to Postgres as the RLS-bound role.
DATABASE_URL=postgres://blink_api:blink_api_dev_password@localhost:5432/blink
PORT=8787
# Better Auth (identity for sync). Generate a real secret: `openssl rand -base64 32`.
# BETTER_AUTH_URL is the server's own public base URL (Better Auth is mounted at /v1/auth).
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-32ch
BETTER_AUTH_URL=http://localhost:8787
# Host port for the docker-compose Postgres (change if 5432 is taken locally).
POSTGRES_PORT=5432
# What the desktop client points its HttpSyncTransport at.
SYNC_API_URL=http://localhost:8787
SYNC_API_TOKEN=

# --- Optional: managed-cloud tenants (SupabaseSyncTransport) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Phase 1/2: AI title generation (cloud proxy over Enterprise VPN) ---
# Leave empty to use the on-device / heuristic engine.
BLINK_AI_PROXY_URL=

# --- Phase 1: Linear export (direct OAuth in client) ---
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
